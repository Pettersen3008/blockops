# Copy to .env and replace every required value. This file contains no credentials.
BLOCKOPS_MINECRAFT_CONTAINER=
BLOCKOPS_RCON_ADDRESS=minecraft:25575
BLOCKOPS_RCON_PASSWORD=
BLOCKOPS_ENCRYPTION_KEY=

# Use an exact ghcr.io digest for a tagged release. Keep blockops:local when
# building the image from this checkout.
BLOCKOPS_IMAGE=blockops:local

# Use the exact external HTTPS origin in production, with no trailing slash.
BLOCKOPS_PUBLIC_ORIGIN=http://localhost:5173
BLOCKOPS_COOKIE_SECURE=true

# The dashboard binds to loopback by default. A host reverse proxy can reach it here.
BLOCKOPS_BIND_ADDRESS=127.0.0.1
BLOCKOPS_PORT=8080

# Required, no default. Pick exactly one of the two documented sources for the
# existing server's data directory (the one holding server.properties and worlds):
#   1. Absolute host path: MINECRAFT_DATA_SOURCE=/srv/minecraft, then `docker compose up -d`.
#   2. Existing named volume: MINECRAFT_DATA_SOURCE=minecraft-data plus the line below,
#      which makes every compose command in this directory use the override file.
#      COMPOSE_FILE=compose.yaml:compose.minecraft-volume.yaml
# The volume is never created for you. A wrong name fails at startup instead of
# mounting an empty directory.
MINECRAFT_DATA_SOURCE=
BLOCKOPS_WORLD_NAME=world

# Only list CIDRs of reverse proxies that directly connect to BlockOps.
BLOCKOPS_TRUSTED_PROXIES=
BLOCKOPS_SESSION_TTL=12h
BLOCKOPS_MAX_UPLOAD_BYTES=2147483648
# Audit CSV exports stop at this row count. Valid range: 1 to 100000.
BLOCKOPS_MAX_AUDIT_EXPORT_ROWS=10000
